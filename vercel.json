{
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "static/$1"
        },
        {
            "src": "/public/(.*)",
            "dest": "public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "main.py"
        }
    ]
}
